{
  "manifest_version": 3,
  "name": "Voice Assistant: YouTube Music bridge",
  "version": "1.1.0",
  "description": "Lets the Voice Assistant app on this PC search and play songs in your signed-in YouTube Music. Talks only to the app on 127.0.0.1 and only touches music.youtube.com.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "unload-guard.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}